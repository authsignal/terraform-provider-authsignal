{
  "actionNodes": [
    {
      "nodeId": "evaluate-risk",
      "nodeType": "RULE",
      "parentNodeIds": [],
      "ruleChildNodeIds": [["high-risk", "verify-identity"], ["blocked-country", "block-request"]],
      "elseChildNodeId": "complete-sign-in"
    },
    {
      "nodeId": "verify-identity",
      "nodeType": "VERIFICATION",
      "parentNodeIds": ["evaluate-risk"],
      "name": "Sign in",
      "methodConfigurations": {"PASSKEY": {"isEnabled": true}, "EMAIL_OTP": {"isEnabled": true}},
      "childNodeId": "complete-sign-in"
    },
    {"nodeId": "block-request", "nodeType": "BLOCK", "parentNodeIds": ["evaluate-risk"]},
    {"nodeId": "complete-sign-in", "nodeType": "COMPLETE", "parentNodeIds": ["evaluate-risk", "verify-identity"]}
  ],
  "rules": [
    {"ruleId": "high-risk", "name": "High risk score", "conditions": {"and": [{">": [{"var": "custom.risk_score"}, 70]}]}},
    {"ruleId": "blocked-country", "name": "Blocked country", "conditions": {"and": [{"in": [{"var": "ip.location.country.countryCode"}, {"var": "lists.blocked-countries"}]}]}}
  ]
}
